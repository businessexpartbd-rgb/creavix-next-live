# ─── Required for ChatBot (optional) ───────────────────────────────
# Anthropic API key for the AI ChatBot. Without this, the chatbot
# falls back to canned bilingual responses (still works).
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Required for email subscribe + nightly follow-up cron ──────────
# Resend API key for transactional emails. Without this, the
# subscribe form falls back to mailto: and the cron is a no-op.
# Get one at: https://resend.com/api-keys
RESEND_API_KEY=

# ─── Site identity (already in lib/site-data.ts; override only if needed)
NEXT_PUBLIC_WA_NUMBER=8801890484355
NEXT_PUBLIC_EMAIL=info@creavixit.com
NEXT_PUBLIC_SITE_URL=https://www.creavixit.com

# ─── Cron secret (set this on Vercel; leave blank in local dev) ─────
# Vercel sends this in the Authorization header for cron requests.
CRON_SECRET=

# ─── Cloudflare Turnstile (human verification on review form) ───────
# Public site key — exposed to browser via NEXT_PUBLIC_ prefix.
# Get it at: https://dash.cloudflare.com/?to=/:account/turnstile
# Without these the review form stays open but skips verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-side secret key — used in /api/review to validate the token.
TURNSTILE_SECRET_KEY=
